PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio_builder

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=

# Google Sheets Option A: Google Apps Script Webhook URL (Easiest, zero GCP IAM setup!)
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=

# Google Sheets Option B: Google Cloud Service Account (Optional)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=
